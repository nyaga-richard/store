    "admin:create": "tsx scripts/create-admin.ts"
  },
  "dependencies": {
    "next": "15.5.29",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "pg": "8.16.3",
    "zod": "3.25.76",
    "stripe": "18.5.0",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@types/node": "22.13.10",
    "@types/pg": "8.11.11",
    "@types/react": "19.0.10",
    "@types/react-dom": "19.0.4",
    "autoprefixer": "10.4.21",
    "postcss": "8.5.3",
    "tailwindcss": "3.4.19",
    "tsx": "4.19.3",
    "typescript": "5.8.2"
  },
  "engines": {
    "node": ">=20"
