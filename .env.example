# Copy to .env and fill in before ./deploy.sh (script does this for you).
# PostgreSQL credentials are used by both the app and the postgres container.
POSTGRES_USER=store
POSTGRES_PASSWORD=change-me-to-a-long-random-secret
POSTGRES_DB=store

# Internal Docker URL. Never expose PostgreSQL publicly.
DATABASE_URL=postgresql://store:change-me-to-a-long-random-secret@db:5432/store

# Public origin behind Cloudflare Tunnel (no trailing slash).
APP_URL=https://shop.trustedsystems.co.ke

# Generate with: openssl rand -base64 48
SESSION_SECRET=replace-with-a-long-random-secret

# Card provider defaults: stripe | mock (mock is for local development only).
# These values seed /admin/payments; after that, edit them in the backoffice.
PAYMENT_PROVIDER=mock
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# M-Pesa (Safaricom Daraja STK push). Enable and edit in /admin/payments.
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_ENVIRONMENT=sandbox
MPESA_CALLBACK_SECRET=replace-with-a-long-random-token

# Cloudflare Tunnel token from Zero Trust dashboard (Network > Tunnels).
TUNNEL_TOKEN=

# Comma-separated customer emails allowed to access /admin.
# The email must already exist in the customer table (see README to bootstrap).
ADMIN_EMAILS=

# App port inside Docker; no public ports are published.
PORT=3000
